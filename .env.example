# Copy to .env and fill in values — Strict Spec Fields First
# ---------------------------------------------------------------------------
# Strict Spec — app/config.py models these verbatim
OPENAI_API_KEY=
PHOENIX_PROJECT_NAME=voice-doc-assistant
ENABLE_TRACING=true
PORT=8000

# ---------------------------------------------------------------------------
# Core (ergonomic)
PROJECT_NAME="Voice-Doc Assistant"
ENVIRONMENT=development
HOST=0.0.0.0
LOG_LEVEL=INFO

# Auth — JWT bearer token (HS256)
AUTH_REQUIRE_EMAIL=false
ALLOWED_ORIGINS=*
JWT_SECRET_KEY=dev-secret-change-in-production-please-set-JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Voice providers — google-genai selected (per user request)
# For Gemini Live via google-genai, set GOOGLE_API_KEY (preferred) or GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEY=
VOICE_PROVIDER=gemini
# gemini = google-genai Live, openai = OpenAI Realtime, auto = first available, mock = no spend
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
GEMINI_LIVE_MODEL=gemini-2.0-flash

# Audio — must match frontend 16kHz PCM
SAMPLE_RATE=16000
CHUNK_MS=100

# Observability — Phoenix Cloud per docs (PHOENIX_COLLECTOR_ENDPOINT is canonical)
# For local dev: TRACING_EXPORTER=console + PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# For Phoenix Cloud: TRACING_EXPORTER=phoenix + PHOENIX_COLLECTOR_ENDPOINT='https://app.phoenix.arize.com/s/...' + PHOENIX_API_KEY
TRACING_EXPORTER=console
# console | phoenix | otlp | none
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_API_KEY=
OTEL_SERVICE_NAME=voice-doc-assistant

# Documents — legacy in-memory limits
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_IN_MEMORY=50

# Vector DB — pgvector (primary per your request) + LangChain
# If VECTOR_DB_URL is not set, uses in-memory FAISS-like vectors (works without Postgres)
VECTOR_DB_URL=postgresql://user:pass@localhost:5432/voice_docs
# Alternative: DATABASE_URL (common in PaaS)
# DATABASE_URL=postgresql://user:pass@localhost:5432/voice_docs
EMBEDDING_PROVIDER=openai
# openai | sentence_transformers (local, no API key)
EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small (1536d), text-embedding-3-large (3072d), or multilingual-e5 (768d) for JP/AR
EMBEDDING_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=100
VECTOR_TOP_K=3
VECTOR_THRESHOLD=
HYBRID_ALPHA=0.5

# Optional: LangChain / LangSmith alternative (not spec-required)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
